# Copie para .env e ajuste conforme necessário. Todos os campos são opcionais
# (têm padrões sensatos). Caminhos relativos são resolvidos a partir da raiz do
# projeto.

# --- Pastas do fluxo ---
YPA_READY_DIR=READY_TO_UPLOAD
YPA_UPLOADED_DIR=UPLOADED
YPA_FAILED_DIR=FAILED
YPA_LOG_FILE=logs/uploads.csv

# --- Credenciais OAuth do YouTube Data API ---
YPA_CLIENT_SECRET=credentials/client_secret.json
YPA_TOKEN_FILE=credentials/token.json

# --- Comportamento ---
# Intervalo de varredura no modo 'watch' (segundos).
YPA_POLL_INTERVAL=15
# Espera o arquivo parar de crescer antes de subir (segundos). 0 desativa.
YPA_STABILITY_WINDOW=5

# --- Padrões aplicados quando o metadado não traz o campo ---
YPA_DEFAULT_PRIVACY=private
YPA_DEFAULT_CATEGORY_ID=22
YPA_DEFAULT_MADE_FOR_KIDS=false
